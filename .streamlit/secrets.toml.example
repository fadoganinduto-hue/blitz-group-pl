# Copy to secrets.toml and fill in. NEVER commit secrets.toml.
GEMINI_API_KEY = "your-key-here"

# ---------------------------------------------------------------------------
# IMPORTANT — key order matters in TOML
# ---------------------------------------------------------------------------
# A bare key belongs to whichever [section] precedes it. Top-level keys such as
# AZURE_TENANT_ID and GEMINI_API_KEY must therefore appear ABOVE the first
# [section] header, or they silently become part of that section.
#
# ---------------------------------------------------------------------------
# SharePoint credentials — same three values as the other Blitz dashboards.
# These MUST stay above [workbook].
# ---------------------------------------------------------------------------
# AZURE_TENANT_ID     = "00000000-0000-0000-0000-000000000000"
# AZURE_CLIENT_ID     = "00000000-0000-0000-0000-000000000000"
# AZURE_CLIENT_SECRET = "the-secret-VALUE-not-the-secret-id"

# ---------------------------------------------------------------------------
# Where the workbook comes from
# ---------------------------------------------------------------------------
# mode = "sharepoint"  read live from SharePoint via Microsoft Graph
#      = "local"       read a path on disk (use a OneDrive-synced folder)
#      = "upload"      manual file upload only (the default)
[workbook]
mode = "upload"
# Used only when mode = "local". A OneDrive-synced SharePoint folder works here.
# path = "/Users/you/Library/CloudStorage/OneDrive-SharedLibraries-Blitz/Finance - Documents/Group PL/Group_PL_2026_Upload.xlsx"

# Paste the SharePoint URL straight from the browser address bar, or the
# file's ... > Copy link menu. Both work.
# [files]
# GROUP_PL = "https://61nngljuq69wkvzlaiog9kkphca.sharepoint.com/sites/Finance/Shared Documents/Group PL/Group_PL_2026_Upload.xlsx"

# Alternative to file_url: address the file explicitly by site and path.
# More typing, but it does not depend on a share link staying valid.
# [sharepoint]
# hostname  = "61nngljuq69wkvzlaiog9kkphca.sharepoint.com"
# site_path = "/sites/Finance"
# file_path = "Shared Documents/Group PL/Group_PL_2026_Upload.xlsx"
